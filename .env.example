# Reference only: no automatic dotenv loading.
LIVE_AI_ENABLED=false
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=
# Required positive integers before enabling live AI; no paid defaults.
MAX_INPUT_TOKENS=
MAX_OUTPUT_TOKENS=
STUDENT_DAILY_TOKEN_LIMIT=
PROJECT_DAILY_TOKEN_LIMIT=
MAX_INTERVIEW_QUESTIONS=
MAX_ANSWER_CHARS=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_OPENAI_ENDPOINT=
# Optional for local administration only. Prefer managed identity in hosted environments.
AZURE_SEARCH_API_KEY=
EMBEDDING_DEPLOYMENT=
KNOWLEDGE_CORPUS_VERSION=
EMBEDDING_DIMENSIONS=
DATABASE_URL=sqlite:///data/private/placement.db
PRIVATE_STORAGE_DIR=data/private
# Hosted single-replica mode: keep SQLite local and snapshot after each commit.
DATABASE_SNAPSHOT_PATH=
AUTH_MODE=local_demo
DEPLOYMENT_ENVIRONMENT=local
LOG_LEVEL=INFO
# Never put credentials in this file or GitHub.
